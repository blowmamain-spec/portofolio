# Dev image: runs `php artisan serve` against a bind-mounted copy of
# backend/, so code edits on the host take effect immediately — no rebuild.
# Not used in production (see ./Dockerfile).
FROM php:8.3-cli-alpine

RUN apk add --no-cache postgresql-dev $PHPIZE_DEPS \
    && docker-php-ext-install pdo_pgsql pgsql \
    && apk del $PHPIZE_DEPS

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

EXPOSE 8000

CMD ["php", "artisan", "serve", "--host=0.0.0.0", "--port=8000"]
