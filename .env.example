# Variables used by docker-compose.prod.yml itself (not by Laravel or
# React directly — those read backend/.env and frontend/.env).
#
# Copy to .env on the homeserver: cp .env.example .env

# Root domain. Frontend serves at this domain, API at api.<this domain>.
DOMAIN=nfab.my.id

# Must match backend/.env's DB_DATABASE / DB_USERNAME / DB_PASSWORD —
# the backend container reads its own .env, these are for the db and
# db-backup containers.
DB_DATABASE=portofolio
DB_USERNAME=portofolio
DB_PASSWORD=change-me

# No Cloudflare Tunnel token needed here — the tunnel is set up once via
# the cloudflared CLI (./cloudflared/ holds its cert + credentials, never
# committed). See docs/DEPLOYMENT.md.
